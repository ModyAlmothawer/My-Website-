<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>إنشاء صفحة إهداء</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container mt-5">
    <h2 class="text-center mb-4">إنشاء صفحة إهداء جديدة</h2>
    <div class="row justify-content-center">
      <div class="col-md-8">
        <form id="createForm" class="shadow p-4 bg-light rounded">
          <div class="mb-3">
            <label>اسم المتوفى/المهدى له</label>
            <input type="text" class="form-control" id="name" required />
          </div>
          <div class="mb-3">
            <label>رسالة</label>
            <textarea class="form-control" id="message" rows="3" required></textarea>
          </div>
          <div class="mb-3">
            <label>تاريخ الميلاد</label>
            <input type="date" class="form-control" id="birthDate" />
          </div>
          <div class="mb-3">
            <label>تاريخ الوفاة (اختياري)</label>
            <input type="date" class="form-control" id="deathDate" />
          </div>
          <div class="mb-3">
            <label>لون الصفحة</label>
            <input type="color" class="form-control form-control-color" id="pageColor" value="#f5f0eb" />
          </div>
          <div class="mb-3">
            <label>دعاء مخصص (اختياري)</label>
            <textarea class="form-control" id="customDua" rows="2"></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100">إنشاء الصفحة</button>
        </form>
        <div id="createResult" class="mt-3"></div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>