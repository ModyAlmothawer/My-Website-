<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>منصة المسبحة الإلكترونية - الرئيسية</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <meta name="description" content="منصة للذكر والدعاء وإهداء الثواب، مع ختم القرآن وصفحات تذكارية." />
  <meta property="og:title" content="منصة المسبحة الإلكترونية" />
  <meta property="og:description" content="تسبيح، دعاء، ختم قرآن، وإهداء للأموات." />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
      <a class="navbar-brand" href="/">المسبحة الإلكترونية</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link active" href="/">الرئيسية</a></li>
          <li class="nav-item"><a class="nav-link" href="/create">أنشئ صفحة</a></li>
          <% if (user) { %>
            <li class="nav-item"><a class="nav-link" href="/api/memorial/my-memorial">لوحتي</a></li>
            <li class="nav-item"><a class="nav-link" href="#" id="logoutBtn">تسجيل خروج</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#loginModal">تسجيل دخول</a></li>
            <li class="nav-item"><a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#registerModal">اشتراك</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container my-5 text-center">
    <h1 class="display-4">مرحباً بك في منصة المسبحة الإلكترونية</h1>
    <p class="lead">اذكر الله، واهدِ الثواب لأحبابك، واختم القرآن معاً</p>
    <div class="row mt-5">
      <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
          <div class="card-body">
            <i class="fas fa-hands-praying fa-3x text-primary"></i>
            <h5 class="card-title mt-3">تسبيح</h5>
            <p class="card-text">أذكار يومية مع عدادات تفاعلية</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
          <div class="card-body">
            <i class="fas fa-book-quran fa-3x text-success"></i>
            <h5 class="card-title mt-3">ختم القرآن</h5>
            <p class="card-text">شارك في ختم القرآن مع الآخرين</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
          <div class="card-body">
            <i class="fas fa-heart fa-3x text-danger"></i>
            <h5 class="card-title mt-3">إهداء</h5>
            <p class="card-text">أنشئ صفحة تذكارية وأهدِ الثواب</p>
          </div>
        </div>
      </div>
    </div>
    <a href="/create" class="btn btn-primary btn-lg mt-4">ابدأ الآن <i class="fas fa-arrow-left"></i></a>
  </div>

  <!-- مودالات تسجيل الدخول والاشتراك (اختصار) -->
  <div class="modal fade" id="loginModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">تسجيل الدخول</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="loginForm">
            <div class="mb-3">
              <label>البريد الإلكتروني</label>
              <input type="email" class="form-control" id="loginEmail" required />
            </div>
            <div class="mb-3">
              <label>كلمة المرور</label>
              <input type="password" class="form-control" id="loginPassword" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">دخول</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="registerModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">إنشاء حساب</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="registerForm">
            <div class="mb-3">
              <label>الاسم</label>
              <input type="text" class="form-control" id="regName" required />
            </div>
            <div class="mb-3">
              <label>البريد الإلكتروني</label>
              <input type="email" class="form-control" id="regEmail" required />
            </div>
            <div class="mb-3">
              <label>كلمة المرور</label>
              <input type="password" class="form-control" id="regPassword" required minlength="6" />
            </div>
            <button type="submit" class="btn btn-success w-100">اشتراك</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>