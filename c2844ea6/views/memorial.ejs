<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>صفحة إهداء - <%= memorial.name %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    body { background-color: <%= memorial.pageColor %>; transition: background-color 0.5s; }
    .counter-card { background: rgba(255,255,255,0.8); border-radius: 15px; padding: 15px; margin-bottom: 10px; }
    .juz-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
    .juz-item { background: #fff; border-radius: 10px; padding: 10px; text-align: center; cursor: pointer; }
    .juz-item.reserved { background: #d4edda; border: 2px solid #28a745; }
    .juz-item.available { background: #f8f9fa; border: 2px solid #6c757d; }
    .juz-item:hover { transform: scale(1.03); }
  </style>
</head>
<body>
  <div class="container py-4">
    <!-- صورة واسم -->
    <div class="text-center mb-4">
      <img src="<%= memorial.image %>" alt="صورة" class="rounded-circle" width="120" height="120" style="object-fit: cover;" />
      <h1 class="mt-2"><%= memorial.name %></h1>
      <p class="text-muted"><%= memorial.message %></p>
      <% if (memorial.customDua) { %>
        <blockquote class="blockquote">الدعاء: <%= memorial.customDua %></blockquote>
      <% } %>
      <div>
        <span class="badge bg-secondary"><i class="far fa-calendar-alt"></i> ميلاد: <%= memorial.birthDate ? new Date(memorial.birthDate).toLocaleDateString('ar-EG') : 'غير محدد' %></span>
        <% if (memorial.deathDate) { %>
          <span class="badge bg-dark"><i class="fas fa-cross"></i> وفاة: <%= new Date(memorial.deathDate).toLocaleDateString('ar-EG') %></span>
        <% } %>
      </div>
    </div>

    <!-- عدادات الأذكار -->
    <h3><i class="fas fa-pray"></i> الأذكار</h3>
    <div class="row" id="countersContainer">
      <% 
        const dhikrList = Object.keys(counters);
        dhikrList.forEach(dhikr => {
          const count = counters[dhikr] || 0;
      %>
        <div class="col-md-4 col-6">
          <div class="counter-card text-center">
            <h5><%= dhikr %></h5>
            <h3 id="counter-<%= dhikr.replace(/\s/g,'') %>"><%= count %></h3>
            <button class="btn btn-success btn-sm increment-btn" data-dhikr="<%= dhikr %>"><i class="fas fa-plus"></i></button>
            <button class="btn btn-danger btn-sm reset-btn" data-dhikr="<%= dhikr %>"><i class="fas fa-undo"></i></button>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- ختم القرآن -->
    <h3 class="mt-4"><i class="fas fa-book-quran"></i> ختم القرآن</h3>
    <div class="juz-grid">
      <% for (let i=1; i<=30; i++) { 
        const reserved = quranCompletion[i] !== null && quranCompletion[i] !== undefined;
        const reservedBy = quranCompletion[i] || '';
      %>
        <div class="juz-item <%= reserved ? 'reserved' : 'available' %>" data-juz="<%= i %>" data-reserved="<%= reserved %>">
          <strong>الجزء <%= i %></strong>
          <% if (reserved) { %>
            <div><small>محجوز بواسطة: <%= reservedBy %></small></div>
          <% } else { %>
            <div><small>متاح</small></div>
          <% } %>
        </div>
      <% } %>
    </div>
    <!-- نموذج حجز الجزء (سيظهر عند النقر على جزء غير محجوز) -->
    <div id="reserveModal" style="display:none;" class="mt-2">
      <input type="text" id="visitorName" placeholder="اسمك" class="form-control d-inline-block w-50" />
      <button id="confirmReserve" class="btn btn-primary">حجز</button>
    </div>

    <!-- الدعاء -->
    <h3 class="mt-4"><i class="fas fa-hand-pray"></i> الدعاء</h3>
    <div id="prayersList" class="mb-3">
      <% if (memorial.prayers && memorial.prayers.length) { %>
        <% memorial.prayers.forEach(p => { %>
          <div class="border-bottom py-2">
            <strong><%= p.visitorName %></strong> - <small><%= new Date(p.createdAt).toLocaleDateString('ar-EG') %></small>
            <p><%= p.text %></p>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-muted">لا توجد أدعية بعد، كن أول من يدعو.</p>
      <% } %>
    </div>
    <form id="prayerForm">
      <input type="text" id="prayerVisitorName" placeholder="اسمك" class="form-control mb-2" />
      <textarea id="prayerText" class="form-control mb-2" rows="2" placeholder="اكتب دعاء..."></textarea>
      <button type="submit" class="btn btn-secondary">أضف دعاء</button>
    </form>

    <!-- إحصائيات -->
    <div class="row mt-4 text-center">
      <div class="col-3"><span class="badge bg-info">الزوار: <%= memorial.stats.visitors %></span></div>
      <div class="col-3"><span class="badge bg-success">التسبيح: <%= memorial.stats.totalTasbih %></span></div>
      <div class="col-3"><span class="badge bg-warning">الأدعية: <%= memorial.stats.totalPrayers %></span></div>
      <div class="col-3"><span class="badge bg-danger">الختمات: <%= memorial.stats.totalCompletions %></span></div>
    </div>

    <div class="text-center mt-4">
      <a href="/" class="btn btn-outline-primary"><i class="fas fa-home"></i> الرئيسية</a>
    </div>
  </div>

  <script>
    const pageId = "<%= memorial.pageId %>";
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>