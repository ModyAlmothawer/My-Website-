<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>لوحة المستخدم</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container mt-4">
    <h2>لوحة تحكم صفحتي</h2>
    <div class="row">
      <div class="col-md-8">
        <form id="updateForm">
          <div class="mb-3">
            <label>الاسم</label>
            <input type="text" class="form-control" id="editName" value="<%= memorial.name %>" />
          </div>
          <div class="mb-3">
            <label>الرسالة</label>
            <textarea class="form-control" id="editMessage" rows="3"><%= memorial.message %></textarea>
          </div>
          <div class="mb-3">
            <label>تاريخ الميلاد</label>
            <input type="date" class="form-control" id="editBirth" value="<%= memorial.birthDate ? memorial.birthDate.toISOString().split('T')[0] : '' %>" />
          </div>
          <div class="mb-3">
            <label>تاريخ الوفاة</label>
            <input type="date" class="form-control" id="editDeath" value="<%= memorial.deathDate ? memorial.deathDate.toISOString().split('T')[0] : '' %>" />
          </div>
          <div class="mb-3">
            <label>لون الصفحة</label>
            <input type="color" class="form-control form-control-color" id="editColor" value="<%= memorial.pageColor %>" />
          </div>
          <div class="mb-3">
            <label>دعاء مخصص</label>
            <textarea class="form-control" id="editDua" rows="2"><%= memorial.customDua || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-primary">تحديث</button>
        </form>
        <hr />
        <form id="uploadImageForm" enctype="multipart/form-data">
          <div class="mb-3">
            <label>رفع صورة جديدة</label>
            <input type="file" class="form-control" id="imageFile" accept="image/*" />
          </div>
          <button type="submit" class="btn btn-secondary">رفع الصورة</button>
        </form>
      </div>
      <div class="col-md-4">
        <h5>إحصائيات صفحتي</h5>
        <ul class="list-group">
          <li class="list-group-item">الزوار: <%= memorial.stats.visitors %></li>
          <li class="list-group-item">التسبيح: <%= memorial.stats.totalTasbih %></li>
          <li class="list-group-item">الأدعية: <%= memorial.stats.totalPrayers %></li>
          <li class="list-group-item">الختمات: <%= memorial.stats.totalCompletions %></li>
        </ul>
        <div class="mt-3">
          <a href="/p/<%= memorial.pageId %>" target="_blank" class="btn btn-outline-success w-100"><i class="fas fa-external-link-alt"></i> زيارة الصفحة</a>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>